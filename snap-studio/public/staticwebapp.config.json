{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/s/*", "/uploads/*", "/assets/*", "*.{css,js,png,jpg,jpeg,webp,svg,ico,woff2}"]
  },
  "routes": [
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/s/*",
      "allowedRoles": ["anonymous"]
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
